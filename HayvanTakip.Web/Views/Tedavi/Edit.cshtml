@model HayvanTakip.Entities.Tedavi

@{
    ViewBag.Title = "Tedavi Güncelle";
}

<style>
    .form-card {
        max-width: 760px;
        margin: 25px auto;
        padding: 25px;
        background-color: #fff;
        border: 1px solid #dfe5e9;
        border-radius: 8px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }

    .form-title {
        margin-top: 0;
        margin-bottom: 6px;
        color: #263238;
        font-size: 26px;
        font-weight: 600;
    }

    .form-description {
        margin-bottom: 22px;
        color: #78909c;
    }

    .form-card label {
        color: #455a64;
        font-weight: 600;
    }

    .form-actions {
        margin-top: 22px;
    }

        .form-actions .btn {
            margin-right: 6px;
            padding: 9px 16px;
        }

    .required-mark {
        color: #d9534f;
    }
</style>

<div class="form-card">

    <h2 class="form-title">
        Tedavi Kaydı Güncelle
    </h2>

    <p class="form-description">
        Tedavi bilgilerini düzenleyebilirsiniz.
    </p>

    @using (Html.BeginForm("Edit", "Tedavi", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.KayitTarihi)

        @Html.ValidationSummary(
            false,
            "",
            new { @class = "alert alert-danger" }
        )

        <div class="form-group">

            <label>
                Hastalık
                <span class="required-mark">*</span>
            </label>

            @Html.DropDownListFor(
                x => x.HastalikId,
                ViewBag.Hastaliklar as SelectList,
                "Hastalık seçiniz",
                new { @class = "form-control" }
            )

        </div>

        <div class="form-group">

            <label>
                Tedavi Adı
                <span class="required-mark">*</span>
            </label>

            @Html.TextBoxFor(
                x => x.TedaviAdi,
                new
                {
                    @class = "form-control"
                }
            )

        </div>

        <div class="form-group">

            <label>İlaç Adı</label>

            @Html.TextBoxFor(
                x => x.IlacAdi,
                new
                {
                    @class = "form-control"
                }
            )

        </div>

        <div class="row">

            <div class="col-md-6">

                <div class="form-group">

                    <label>Başlangıç Tarihi</label>

                    @Html.TextBoxFor(
                        x => x.BaslangicTarihi,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "form-control",
                            type = "date"
                        }
                    )

                </div>

            </div>

            <div class="col-md-6">

                <div class="form-group">

                    <label>Bitiş Tarihi</label>

                    @Html.TextBoxFor(
                        x => x.BitisTarihi,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "form-control",
                            type = "date"
                        }
                    )

                </div>

            </div>

        </div>

        <div class="form-group">

            <label>Doz Bilgisi</label>

            @Html.TextBoxFor(
                x => x.DozBilgisi,
                new
                {
                    @class = "form-control"
                }
            )

        </div>

        <div class="form-group">

            <label>Açıklama</label>

            @Html.TextAreaFor(
                x => x.Aciklama,
                new
                {
                    @class = "form-control",
                    rows = "4"
                }
            )

        </div>

        <div class="form-actions">

            <button type="submit"
                    class="btn btn-success">

                <span class="glyphicon glyphicon-floppy-disk"></span>
                Güncelle
            </button>

            <a href="@Url.Action("Index", "Tedavi")"
               class="btn btn-default">

                <span class="glyphicon glyphicon-arrow-left"></span>
                Listeye Dön
            </a>

        </div>
    }

</div>