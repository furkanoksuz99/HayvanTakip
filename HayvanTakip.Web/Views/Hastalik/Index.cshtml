@using System.Linq
@model List<HayvanTakip.Entities.Hastalik>

@{
    ViewBag.Title = "Hastalıklar";
}

<style>
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .page-title {
        margin: 0;
        color: #263238;
        font-size: 28px;
        font-weight: 600;
    }

    .page-description {
        margin-top: 6px;
        margin-bottom: 0;
        color: #78909c;
    }

    .btn-add {
        padding: 10px 16px;
        border-radius: 6px;
        font-weight: 600;
    }

    .table-card {
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid #dfe5e9;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .hastalik-table {
        margin-bottom: 0;
    }

        .hastalik-table thead {
            background-color: #f0f4f7;
        }

        .hastalik-table th {
            color: #455a64;
            font-weight: 600;
        }

        .hastalik-table th,
        .hastalik-table td {
            padding: 12px !important;
            vertical-align: middle !important;
        }

    .status-label {
        display: inline-block;
        min-width: 90px;
        padding: 5px 9px;
        border-radius: 14px;
        text-align: center;
        font-size: 12px;
        font-weight: 600;
    }

    .status-active {
        color: #c62828;
        background-color: #ffebee;
    }

    .status-finished {
        color: #2e7d32;
        background-color: #e8f5e9;
    }

    .action-cell {
        width: 120px;
        white-space: nowrap;
    }

    .action-button {
        width: 35px;
        height: 33px;
        margin-right: 3px;
        padding: 6px 8px;
        border-radius: 5px;
    }

    .empty-message {
        padding: 30px !important;
        color: #78909c;
        text-align: center;
    }

    .modal-detail-table th {
        width: 35%;
        background-color: #f5f7f8;
    }

    @@media (max-width: 768px) {
        .page-header-row {
            display: block;
        }

        .btn-add {
            margin-top: 14px;
        }
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <span class="glyphicon glyphicon-ok-sign"></span>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <span class="glyphicon glyphicon-exclamation-sign"></span>
        @TempData["Error"]
    </div>
}

<div class="page-header-row">

    <div>
        <h2 class="page-title">Hastalıklar</h2>

        <p class="page-description">
            Hayvanların hastalık ve teşhis kayıtlarını yönetebilirsiniz.
        </p>
    </div>

    <div>
        <a href="@Url.Action("Create", "Hastalik")"
           class="btn btn-success btn-add">

            <span class="glyphicon glyphicon-plus"></span>
            Yeni Hastalık Kaydı
        </a>
    </div>

</div>

<div class="table-card">

    <div class="table-responsive">

        <table class="table table-hover hastalik-table">

            <thead>
                <tr>
                    <th>Küpe No</th>
                    <th>İşletme</th>
                    <th>Hastalık Adı</th>
                    <th>Teşhis Tarihi</th>
                    <th>Durum</th>
                    <th>Belirtiler</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var hastalik in Model)
                    {
                        <tr>

                            <td>
                                @if (hastalik.Hayvan != null)
                                {
                                    <strong>
                                        @hastalik.Hayvan.KupeNo
                                    </strong>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Hayvan bulunamadı
                                    </span>
                                }
                            </td>

                            <td>
                                @if (hastalik.Hayvan != null &&
                                     hastalik.Hayvan.Isletme != null)
                                {
                                    @hastalik.Hayvan.Isletme.IsletmeAdi
                                }
                                else
                                {
                                    <span class="text-muted">
                                        İşletme bulunamadı
                                    </span>
                                }
                            </td>

                            <td>
                                @hastalik.HastalikAdi
                            </td>

                            <td>
                                @hastalik.TeshisTarihi.ToString("dd.MM.yyyy")
                            </td>

                            <td>
                                @if (hastalik.DevamEdiyorMu)
                                {
                                    <span class="status-label status-active">
                                        Devam Ediyor
                                    </span>
                                }
                                else
                                {
                                    <span class="status-label status-finished">
                                        Tamamlandı
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(hastalik.Belirtiler))
                                {
                                    @hastalik.Belirtiler
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Belirti girilmedi
                                    </span>
                                }
                            </td>

                            <td class="action-cell">

                                <button type="button"
                                        class="btn btn-info btn-sm action-button btn-detay"
                                        title="Detay"
                                        data-id="@hastalik.Id"
                                        data-kupeno="@(hastalik.Hayvan != null
                                            ? hastalik.Hayvan.KupeNo
                                            : "Hayvan bulunamadı")"
                                        data-isletme="@(hastalik.Hayvan != null &&
                                                        hastalik.Hayvan.Isletme != null
                                            ? hastalik.Hayvan.Isletme.IsletmeAdi
                                            : "İşletme bulunamadı")"
                                        data-hastalikadi="@hastalik.HastalikAdi"
                                        data-teshistarihi="@hastalik.TeshisTarihi.ToString("dd.MM.yyyy")"
                                        data-belirtiler="@(string.IsNullOrWhiteSpace(hastalik.Belirtiler)
                                            ? "Belirti girilmedi"
                                            : hastalik.Belirtiler)"
                                        data-aciklama="@(string.IsNullOrWhiteSpace(hastalik.Aciklama)
                                            ? "Açıklama girilmedi"
                                            : hastalik.Aciklama)"
                                        data-durum="@(hastalik.DevamEdiyorMu
                                            ? "Devam Ediyor"
                                            : "Tamamlandı")"
                                        data-kayittarihi="@hastalik.KayitTarihi.ToString("dd.MM.yyyy HH:mm")">
                                    👁
                                    <span class="glyphicon glyphicon-eye-open"></span>
                                </button>


                                <a href="@Url.Action(
                                             "Edit",
                                             "Hastalik",
                                             new { id = hastalik.Id })"
                                   class="btn btn-warning btn-sm action-button"
                                   title="Güncelle">
                                    ✏️
                                    <span class="glyphicon glyphicon-pencil"></span>
                                </a>

                                @using (Html.BeginForm(
"Delete",
"Hastalik",
new { id = hastalik.Id },
FormMethod.Post,
new
{
style = "display:inline-block; margin:0;",
onsubmit = "return confirm('Bu hastalık kaydını silmek istediğinize emin misiniz?');"
}))
                                {
                                    @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger btn-sm action-button"
                                    title="Sil">
                                🗑
                                <span class="glyphicon glyphicon-trash"></span>
                            </button>
                                }
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="empty-message">

                            <span class="glyphicon glyphicon-info-sign"></span>
                            Henüz hastalık kaydı bulunmuyor.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<div class="modal fade"
     id="hastalikDetayModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="hastalikDetayBaslik">

    <div class="modal-dialog"
         role="document">

        <div class="modal-content">

            <div class="modal-header">

                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Kapat">

                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>

                <h4 class="modal-title"
                    id="hastalikDetayBaslik">

                    <span class="glyphicon glyphicon-info-sign"></span>
                    Hastalık Detayı
                </h4>

            </div>

            <div class="modal-body">

                <table class="table table-bordered modal-detail-table">

                    <tbody>

                        <tr>
                            <th>Id</th>
                            <td id="detayId"></td>
                        </tr>

                        <tr>
                            <th>Küpe Numarası</th>
                            <td id="detayKupeNo"></td>
                        </tr>

                        <tr>
                            <th>İşletme</th>
                            <td id="detayIsletme"></td>
                        </tr>

                        <tr>
                            <th>Hastalık Adı</th>
                            <td id="detayHastalikAdi"></td>
                        </tr>

                        <tr>
                            <th>Teşhis Tarihi</th>
                            <td id="detayTeshisTarihi"></td>
                        </tr>

                        <tr>
                            <th>Belirtiler</th>
                            <td id="detayBelirtiler"></td>
                        </tr>

                        <tr>
                            <th>Açıklama</th>
                            <td id="detayAciklama"></td>
                        </tr>

                        <tr>
                            <th>Durum</th>
                            <td id="detayDurum"></td>
                        </tr>

                        <tr>
                            <th>Kayıt Tarihi</th>
                            <td id="detayKayitTarihi"></td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-default"
                        data-dismiss="modal">

                    Kapat
                </button>

            </div>

        </div>

    </div>

</div>

@section scripts
{
    <script>
        $(document).ready(function () {

            $(".btn-detay").click(function () {

                var buton = $(this);

                $("#detayId").text(
                    buton.attr("data-id")
                );

                $("#detayKupeNo").text(
                    buton.attr("data-kupeno")
                );

                $("#detayIsletme").text(
                    buton.attr("data-isletme")
                );

                $("#detayHastalikAdi").text(
                    buton.attr("data-hastalikadi")
                );

                $("#detayTeshisTarihi").text(
                    buton.attr("data-teshistarihi")
                );

                $("#detayBelirtiler").text(
                    buton.attr("data-belirtiler")
                );

                $("#detayAciklama").text(
                    buton.attr("data-aciklama")
                );

                $("#detayDurum").text(
                    buton.attr("data-durum")
                );

                $("#detayKayitTarihi").text(
                    buton.attr("data-kayittarihi")
                );

                $("#hastalikDetayModal").modal("show");
            });

        });
    </script>
}