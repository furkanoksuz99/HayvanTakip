@model HayvanTakip.Entities.Hayvan

@{
    ViewBag.Title = "Yeni Hayvan";
}

<h2>Yeni Hayvan</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="form-group">
        <label>Küpe Numarası</label>
        @Html.TextBoxFor(
            x => x.KupeNo,
            new { @class = "form-control" }
        )
    </div>

    <div class="form-group">
        <label>İşletme</label>

        @Html.DropDownListFor(
            x => x.IsletmeId,
            ViewBag.Isletmeler as SelectList,
            "İşletme seçiniz",
            new { @class = "form-control" }
        )
    </div>

    <div class="form-group">
        <label>Tür</label>
        @Html.TextBoxFor(
            x => x.Tur,
            new { @class = "form-control" }
        )
    </div>

    <div class="form-group">
        <label>Irk</label>
        @Html.TextBoxFor(
            x => x.Irk,
            new { @class = "form-control" }
        )
    </div>

    <div class="form-group">
        <label>Cinsiyet</label>

        @Html.EnumDropDownListFor(
            x => x.Cinsiyet,
            "Cinsiyet seçiniz",
            new { @class = "form-control" }
        )
    </div>

    <div class="form-group">
        <label>Doğum Tarihi</label>

        @Html.TextBoxFor(
            x => x.DogumTarihi,
            "{0:yyyy-MM-dd}",
            new
            {
                @class = "form-control",
                type = "date"
            }
        )
    </div>

    <br />

    <button type="submit" class="btn btn-success">
        Kaydet
    </button>

    @Html.ActionLink(
        "Listeye Dön",
        "Index",
        null,
        new { @class = "btn btn-default" }
    )
}